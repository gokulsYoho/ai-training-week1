   "outputs": [],
   "source": [
    "%timeit [x * 2 for x in range(1000)]\n",
    "def make_list():\n",
    "    res = []\n",
    "    for x in range(1000):\n",
    "        res.append(x * 2)\n",
    "    return res\n",
    "%timeit make_list()"
   ]
